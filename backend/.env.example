# CONFIGURACIÓN DEL SERVIDOR
PORT=5000
FRONTEND_URL=https://restaurante-prueba-chi.vercel.app

# BASE DE DATOS MySQL (obligatorio)
# Local: docker compose up -d  (credenciales por defecto abajo)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=realejo_root
DB_NAME=el_realejo
# DB_PORT=3306

# CONFIGURACIÓN DE CORREO
# Producción (Render): usa Resend — Gmail SMTP suele fallar en la nube
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=El Realejo Tascas <onboarding@resend.dev>

# Local: Gmail con contraseña de aplicación
EMAIL_USER=tu-correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion_de_gmail

# PANEL DE ADMINISTRACIÓN (gestión de reservas)
ADMIN_USER=admin
ADMIN_PASSWORD=tu_contraseña_segura
# Opcional: secreto para firmar tokens (si no se define, usa ADMIN_PASSWORD)
# ADMIN_TOKEN_SECRET=otro_secreto_largo_y_aleatorio
